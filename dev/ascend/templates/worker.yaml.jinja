model:
  name: {{ model.name }}
{% if ascend_decode_graph %}
  instance_id: {{ ascend_decode_graph.instance_id }}
{% endif %}
  weight_version: {{ model.weight_version | tojson }}
  num_layers: {{ model.num_layers }}
  experts_per_layer: {{ model.experts_per_layer }}
  hidden_dim: {{ model.hidden_dim }}
  expert_intermediate_dim: {{ model.intermediate_dim }}
  top_k: {{ model.topk }}
  activation_dtype: {{ model.activation_dtype }}
  weight_dtype: {{ model.weight_dtype }}
{% if model.expert_compute != "swiglu" %}
  expert_compute: {{ model.expert_compute }}
  swiglu_limit: {{ model.swiglu_limit }}
{% endif %}
{% if model.quantization is not none %}
  quantization: {{ model.quantization | tojson }}
{% endif %}

worker:
  id: {{ pool.id }}-{{ worker.id }}
{% if ascend_decode_graph %}
  ascend_decode_graph: {{ ascend_decode_graph | tojson }}
{% endif %}
  backend: {{ pool.backend }}
  device: {{ "npu:0" if ascend_decode_graph else worker.device_name }}
  max_batch_tokens: {{ expert.runtime.max_batch_tokens }}
  max_active_batches_per_device: {{ expert.runtime.max_active_batches_per_device }}
  device_memory_limit: {{ expert.runtime.device_memory_limit }}
  shutdown_grace_secs: {{ expert.runtime.shutdown_grace_secs }}

transport:
{% if transport.type == "transfer_engine" %}
  type: transfer_engine
  max_pending_batches_per_device: {{ expert.runtime.max_pending_batches_per_device }}
  control_listen: 0.0.0.0:{{ worker.port }}
  control_advertise: {{ pool.address }}:{{ worker.port }}
  segment_advertise: {{ pool.address }}:0
  max_workers: {{ transport.max_workers }}
  ascend_receive_fence: {{ transport.ascend_receive_fence }}
{% if transport.max_registered_bytes is not none %}
  max_registered_bytes: {{ transport.max_registered_bytes }}
{% endif %}
{% else %}
  type: grpc
  max_pending_batches_per_device: {{ expert.runtime.max_pending_batches_per_device }}
  listen: 0.0.0.0:{{ worker.port if ascend_decode_graph else 51234 }}
  advertise: {{ pool.address }}:{{ worker.port }}
{% endif %}

controller:
  endpoint: {{ control.address }}:{{ control.worker_control_port }}
  heartbeat_interval_secs: {{ expert.runtime.heartbeat_interval_secs }}
  heartbeat_timeout_secs: {{ expert.runtime.heartbeat_timeout_secs }}

weight_manager:
  max_concurrent_loads: {{ expert.runtime.max_concurrent_loads }}
  disk_cache:
    path: /ek/worker_cache
    writeback: false
  peer:
{% if transport.type == "transfer_engine" %}
    listen: 0.0.0.0:{{ worker.peer_port }}
{% else %}
    listen: 0.0.0.0:{{ worker.peer_port if ascend_decode_graph else 52234 }}
{% endif %}
    advertise: http://{{ pool.address }}:{{ worker.peer_port }}
  weight_server_endpoint: http://{{ control.address }}:{{ control.weight_server_port }}

logging:
  level: INFO
  format: console

observability:
  prometheus:
    enabled: false
  tracing:
    enabled: {{ tracing.enabled | tojson }}
{% if tracing.enabled %}
    endpoint: {{ tracing.endpoint | tojson }}
    sample_ratio: {{ tracing.sample_ratio }}
{% endif %}
