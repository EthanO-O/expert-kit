backend: vllm
model: {{ model.name }}
tokenizer: /model/{{ model.name }}
endpoint: /v1/completions
{% if transport.type == "transfer_engine" or ascend_decode_graph %}
base-url: http://{{ attention.address }}:{{ attention.vllm_port }}
{% else %}
base-url: http://attention:8000
{% endif %}
num-prompts: {{ run.num_prompts }}
{% if dataset.type == "random" %}
dataset-name: random
input-len: {{ run.input_len }}
output-len: {{ run.output_len }}
{% else %}
dataset-name: {{ dataset.type }}
dataset-path: {{ dataset.mounted_path }}/{{ dataset.file }}
output-len: {{ run.output_len }}
{% endif %}
num-warmups: {{ run.num_warmups }}
max-concurrency: {{ run.max_concurrency }}
ignore-eos: {{ run.ignore_eos | lower }}
temperature: {{ run.temperature }}
save-result: {{ run.save_result | lower }}
{% if run.save_detailed is not none %}
save-detailed: {{ run.save_detailed | lower }}
{% endif %}
{% if run.percentile_metrics is not none %}
percentile-metrics: {{ run.percentile_metrics | tojson }}
{% endif %}
{% if run.metric_percentiles is not none %}
metric-percentiles: {{ run.metric_percentiles | tojson }}
{% endif %}
{% if run.ready_check_timeout_sec is not none %}
ready-check-timeout-sec: {{ run.ready_check_timeout_sec }}
{% endif %}
result-dir: /results
label: {{ label }}
