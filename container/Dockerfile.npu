ARG VLLM_ASCEND_IMAGE="quay.io/ascend/vllm-ascend:v0.26.0rc2-a3@sha256:8cbb72814ec80978ab15c0164c43b4e60541cecd1d9f6f4b143ba6ecb4ff63f6"

FROM ${VLLM_ASCEND_IMAGE} AS ek-ascend-runtime

ARG PIP_INDEX_URL="https://pypi.org/simple"

WORKDIR /opt/expert-kit

COPY dist/attention-wheels/expertkit_proto-*-py3-none-any.whl \
     dist/attention-wheels/expertkit_transport-*-py3-none-any.whl \
     dist/attention-wheels/expertkit_worker-*-py3-none-any.whl \
     dist/attention-wheels/expertkit_vllm-*-py3-none-any.whl /tmp/ek-wheels/
COPY dev/ascend/graph-runtime-constraints.txt /tmp/graph-runtime-constraints.txt

RUN python3 -m pip install \
      --no-cache-dir \
      --only-binary=:all: \
      --index-url "${PIP_INDEX_URL}" \
      --constraint /tmp/graph-runtime-constraints.txt \
      /tmp/ek-wheels/*.whl \
      "expertkit-vllm[ascend-graph]==0.1.0"

ENV EK_ENABLE=1

FROM ek-ascend-runtime AS ek-worker-ascend-runtime

FROM ek-ascend-runtime AS ek-vllm-ascend-runtime
