+#ifdef USE_ASCEND_DIRECT
+void TransferEnginePy::acquireAscendWrites() {
+    pybind11::gil_scoped_release release;
+    // Only successful local READ or peer WRITE completion permits this acquire.
+    if (aclrtSynchronizeDevice() != ACL_ERROR_NONE) {
