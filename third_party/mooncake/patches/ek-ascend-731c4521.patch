+
+int TransferEnginePy::disconnectDrainedAscendSegment(const std::string& segment_name) {
+    pybind11::gil_scoped_release release;
+    if (configured_backend_ != "ascend_direct") return -1;
+    {
+        std::lock_guard<std::mutex> guard(mutex_);
+        // Without a transfer handle this engine never initiated a peer link.
+        if (!handle_map_.count(segment_name)) return 0;
+    }
+    auto transport = dynamic_cast<AscendDirectTransport*>(engine_->getTransport("ascend"));
+    return transport ? transport->disconnectDrainedSegment(segment_name) : -1;
+}
+
+int TransferEnginePy::invalidateDrainedAscendSegment(const std::string& segment_name) {
+    pybind11::gil_scoped_release release;
+    if (configured_backend_ != "ascend_direct") return -1;
+    {
+        std::lock_guard<std::mutex> guard(mutex_);
+        handle_map_.erase(segment_name);
+    }
+    // The caller drains sessions first; ADXL links cannot cross process epochs.
+    return engine_->removeLocalSegment(segment_name);
+}
+#endif
