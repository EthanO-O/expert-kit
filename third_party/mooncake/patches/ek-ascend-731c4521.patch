+int TransferExecutorBase::disconnectDrainedSegment(
+    const std::shared_ptr<TransferMetadata::SegmentDesc>& segment_desc) {
+    if (!segment_desc) return -1;
+    aclrtContext saved_ctx = nullptr;
+    if (aclrtGetCurrentContext(&saved_ctx) != ACL_ERROR_NONE) return -1;
+    MAKE_GUARD(ctx_restore,
+               [saved_ctx]() { (void)aclrtSetCurrentContext(saved_ctx); });
+    int first_error = 0;
+    for (size_t idx = 0; idx < getNumEngines(); ++idx) {
+        if (idx >= local_engine_contexts_.size() ||
+            aclrtSetCurrentContext(local_engine_contexts_[idx]) != ACL_ERROR_NONE) {
+            first_error = -1;
+            continue;
+        }
+        const auto target = resolveTargetAdxlEngineName(segment_desc, idx);
+        if (target.empty() || disconnect(idx, target, params_.connect_timeout) != 0) {
+            first_error = -1;
+        }
+    }
+    return first_error;
+}
